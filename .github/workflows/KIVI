      - name: Run full 0.1.12 tests
        run: bash kivi-cleaner/tests/test_core.sh
      - name: Install Android 35
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Build phone APK with bundled TV probe
        run: gradle --no-daemon -p kivi-cleaner :app:assembleDebug
      - name: Verify both APKs
        shell: bash
        run: |
          test -s kivi-cleaner/app/build/outputs/apk/debug/app-debug.apk
          test -s kivi-cleaner/tvprobe/build/outputs/apk/debug/tvprobe-debug.apk
          unzip -p kivi-cleaner/app/build/outputs/apk/debug/app-debug.apk assets/kivi-vpn-probe.apk > probe.apk
          cmp probe.apk kivi-cleaner/tvprobe/build/outputs/apk/debug/tvprobe-debug.apk
      - name: Publish ready-to-install APKs
        shell: bash
        run: |
          mkdir -p artifacts
          cp kivi-cleaner/app/build/outputs/apk/debug/app-debug.apk artifacts/KIVI-Cleaner-0.1.12-phone.apk
          cp kivi-cleaner/tvprobe/build/outputs/apk/debug/tvprobe-debug.apk artifacts/KIVI-VPN-Probe-0.1.10-TV.apk
      - uses: actions/upload-artifact@v4
        with:
          name: KIVI-Cleaner-0.1.12-FULL
          path: artifacts/*.apk
          if-no-files-found: error
